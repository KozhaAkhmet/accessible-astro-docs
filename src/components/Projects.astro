---
import ProjectCard from './ProjectCard.astro'
import { getRepository, type GitHubRepo } from '../utils/github'

const owner = 'incluud'
const names = [
  'accessible-astro-starter',
  'accessible-astro-components',
  'accessible-astro-launcher',
  'accessible-astro-dashboard',
  'accessible-astro-docs',
  'color-contrast-checker',
]

// A failed fetch (no GITHUB_TOKEN, rate limit, offline) must not fail the whole build.
// GitHubStats.vue fetches the stats again in the browser, so the build only needs starting values.
// The card keeps its title and link; the browser fills in the real star and fork counts.
const fallbackRepo = (name: string): GitHubRepo => ({
  name,
  description: 'View the project on GitHub.',
  html_url: `https://github.com/${owner}/${name}`,
  stargazers_count: 0,
  forks_count: 0,
  topics: [],
})

const repos = await Promise.all(
  names.map((name) =>
    getRepository(owner, name).catch((error) => {
      console.warn(`Projects: using fallback for ${owner}/${name} (${error.message})`)
      return fallbackRepo(name)
    }),
  ),
)
---

<section class="projects">
  <div class="container">
    <h2>Our projects</h2>
    <div class="project-grid">
      {
        repos.map((repo) => (
          <Fragment key={repo.name}>
            <ProjectCard href={repo.html_url} title={repo.name} repo={repo} />
          </Fragment>
        ))
      }
      <ProjectCard isPreview title="Coming soon...">
        We are working on more accessible Astro projects, stay tuned for updates!
      </ProjectCard>
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 4rem 1rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 2rem;
    margin-block-start: 2rem;
  }

  h2 {
    margin-block-end: 4rem;
    font-size: var(--sl-text-5xl) !important;
    text-align: center;
  }
</style>
